# Скопируйте в .env (он в .gitignore) и вставьте ключ.
# Нужен только скриптам генерации контента на вашем компьютере — в приложение ключ не попадает.
ANTHROPIC_API_KEY=

# Если ключ создан на уровне организации, без workspace, укажите id workspace из Console
# (Settings → Workspaces, вида wrkspc_…). Для ключа, выпущенного внутри workspace, не нужно.
ANTHROPIC_WORKSPACE_ID=

# ── API проверки ответов (apps/api) ──
# Общий токен для своих: если задан, приложение должно присылать его (EXPO_PUBLIC_APP_TOKEN в apps/mobile/.env)
APP_TOKEN=
# Порт локального API и лимит проверок в сутки на устройство
PORT=8787
DAILY_LIMIT=150

# ── Аккаунты (apps/api) ──
# Локально: docker compose up -d в корне репозитория. Без DATABASE_URL аккаунты выключены.
DATABASE_URL=postgres://refresher:refresher@localhost:5433/refresher
# Origin веб-клиентов через запятую: им разрешены запросы с cookie сессии (CORS и защита от CSRF)
ALLOWED_ORIGINS=http://localhost:5173
# false — только для локальной разработки по http: Secure-cookie по http не отправляется
COOKIE_SECURE=false
