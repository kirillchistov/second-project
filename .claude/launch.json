{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@rr/web",
        "--",
        "--port",
        "5188",
        "--strictPort"
      ],
      "port": 5188
    },
    {
      "name": "mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "ios",
        "-w",
        "@rr/mobile",
        "--",
        "--go"
      ],
      "port": 8081
    }
  ]
}
