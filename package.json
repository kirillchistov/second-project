{
  "name": "react-refresher-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @rr/web --",
    "dev:pages": "npm run dev:pages -w @rr/web --",
    "build": "npm run bundle -w @rr/content && tsc -b && npm run build -w @rr/web",
    "build:pages": "npm run bundle -w @rr/content && tsc -b && npm run build:pages -w @rr/web",
    "bundle:content": "npm run bundle -w @rr/content",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "npm run bundle -w @rr/content && tsc -b",
    "check": "npm run bundle -w @rr/content && tsc -b && oxlint && vitest run",
    "ios": "npm run ios -w @rr/mobile --"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
