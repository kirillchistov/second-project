# Скопируйте в apps/mobile/.env. Эти значения попадают в сборку приложения — ключ Claude сюда не кладём.
# Адрес API проверки: на симуляторе подходит localhost, на телефоне — IP вашего Mac в локальной сети.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Тот же токен, что APP_TOKEN в корневом .env (если он задан)
EXPO_PUBLIC_APP_TOKEN=
